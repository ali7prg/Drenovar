extends SceneTree

# Regenerates src/gait_table.gd from the field GLB models.
# For each unit and gait clip it samples foot/hoof bones over one cycle and
# measures how fast a planted foot travels relative to the root (model units/s
# at scale 1). Usage: godot --headless --path . -s profile_gait.gd

const CLIPS := ["walk", "run"]
const STEPS := 60

func _initialize() -> void:
	call_deferred("run")

func stance_speed(model: Node3D, player: AnimationPlayer, clip: String) -> float:
	var anim := player.get_animation(clip)
	var best := 0.0
	for skeleton: Skeleton3D in model.find_children("*", "Skeleton3D", true, false):
		for bone in skeleton.get_bone_count():
			var bone_name := skeleton.get_bone_name(bone).to_lower()
			if not ("foot" in bone_name or "toe" in bone_name or "hoof" in bone_name):
				continue
			var samples: Array[Vector3] = []
			for i in STEPS + 1:
				player.play(clip)
				player.seek(anim.length * i / STEPS, true)
				samples.append((skeleton.global_transform * skeleton.get_bone_global_pose(bone)).origin)
			var lowest := INF
			for p in samples:
				lowest = minf(lowest, p.y)
			var distance := 0.0
			var duration := 0.0
			for i in STEPS:
				if samples[i].y < lowest + 0.03 and samples[i + 1].y < lowest + 0.03:
					distance += Vector2(samples[i + 1].x - samples[i].x, samples[i + 1].z - samples[i].z).length()
					duration += anim.length / STEPS
			if duration > 0.05:
				best = maxf(best, distance / duration)
	return best

func run() -> void:
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://assets/game.json"))
	var lines := PackedStringArray([
		"extends RefCounted",
		"",
		"# Generated by profile_gait.gd from the field GLB models. Do not edit by hand.",
		"# Planted-foot speed of each gait clip, in model units per second at scale 1.",
		"const STANCE_SPEED := {"])
	for id in data.unitModels:
		var path: String = data.unitModels[id].field
		var model: Node3D = load(path).instantiate()
		root.add_child(model)
		var player: AnimationPlayer = model.find_children("*", "AnimationPlayer", true, false)[0]
		var entry := {}
		for wanted in CLIPS:
			for clip in player.get_animation_list():
				if clip.to_lower() == wanted:
					entry[wanted] = snappedf(stance_speed(model, player, clip), 0.0001)
		lines.append("\t\"%s\": %s," % [id, JSON.stringify(entry)])
		model.free()
	lines.append("}")
	var file := FileAccess.open("res://src/gait_table.gd", FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("GAIT_TABLE written for ", data.unitModels.size(), " units")
	quit(0)
