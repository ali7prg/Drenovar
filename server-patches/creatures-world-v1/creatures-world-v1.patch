diff --git a/v6/tests/world-creatures.test.mjs b/v6/tests/world-creatures.test.mjs
new file mode 100644
index 0000000..d94c708
--- /dev/null
+++ b/v6/tests/world-creatures.test.mjs
@@ -0,0 +1,97 @@
+// creatures-world-v1: Камнеклык and Горный Драгор world hunts next to the unchanged Velkor sites.
+import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';
+import {V6GameServer,project} from '../game.mjs';import {WORLD} from '../terrain.mjs';
+import {velkorSites,worldCreatureSites,worldSite,publicWorld62} from '../../DRENOVAR-Server-v92/gameplay37/server/world62.mjs';
+import {creatureSpec} from '../../DRENOVAR-Server-v92/gameplay37/server/catalog.mjs';
+import {height} from '../../DRENOVAR-Server-v92/dist/environment/world-field56.js';
+import {worldSites62} from '../../DRENOVAR-Server-v92/dist/environment/world-sites62.js';
+
+const VELKOR_BEFORE={'velkor-1':[-0.3463220833800733,-60.12934748083353],'velkor-2':[13.212685558434668,-6.9091741899474535],'velkor-3':[14.46700602537021,-45.68362508993596]};
+
+test('world creature sites: velkor-1..3 unchanged, three Kamneklyk and three Dragor sites on dry ground away from towns',()=>{
+ assert.deepEqual(worldCreatureSites.slice(0,3),velkorSites);
+ for(const s of velkorSites){assert.equal(s.position.x,VELKOR_BEFORE[s.id][0]);assert.equal(s.position.z,VELKOR_BEFORE[s.id][1]);}
+ const ids=worldCreatureSites.map(s=>s.id);
+ assert.deepEqual(ids,['velkor-1','velkor-2','velkor-3','kamneklyk-1','kamneklyk-2','kamneklyk-3','dragor-1','dragor-2','dragor-3']);
+ assert.equal(new Set(ids).size,ids.length);
+ const towns=worldSites62();
+ for(const s of worldCreatureSites.slice(3)){
+  const [species,level]=s.id.split('-');
+  assert.equal(s.spec.id,species);assert.equal(s.level,Number(level));assert.deepEqual(s.spec,creatureSpec(species,s.level));
+  assert.ok(height(s.position.x,s.position.z)>2,s.id+' on land');
+  assert.ok(towns.every(t=>Math.hypot(t.x-s.position.x,t.z-s.position.z)>=16),s.id+' away from every settlement slot');
+  assert.ok(worldCreatureSites.every(o=>o===s||Math.hypot(o.position.x-s.position.x,o.position.z-s.position.z)>=22),s.id+' away from other creatures');
+  assert.ok(s.patrol&&s.patrol.length===2,s.id+' patrols');
+ }
+ // highlands for Dragor, hills for Kamneklyk (02_CREATURES.txt habitats)
+ for(const s of worldCreatureSites.filter(s=>s.spec.id==='dragor'))assert.ok(height(s.position.x,s.position.z)>=21,s.id+' in the highlands');
+ for(const s of worldCreatureSites.filter(s=>s.spec.id==='kamneklyk'))assert.ok(height(s.position.x,s.position.z)>=9,s.id+' on the hills');
+});
+
+function world(){
+ let now=0;const sql=new DatabaseSync(':memory:'),game=new V6GameServer(sql,{clock:()=>now,worldEnabled:true,v6World:WORLD});
+ const player=(units)=>{const id=game.newSession().playerId,p=game.getPlayer(id);p.v6.buildings.find(b=>b.type==='B01').level=11;p.v6.healthy=structuredClone(units);game.putPlayer(project(p));return id;};
+ return {sql,game,player,clock:{get now(){return now;},set now(v){now=v;}}};
+}
+
+// Party sizes that win while the creature still reaches its third (special) attack.
+for(const [species,ability,level,party] of [['kamneklyk','tusk_sweep',3,150],['dragor','shockwave',1,60]])
+ test(`V6 world hunt of ${species}: species worldKind, server battle with ${ability}, reward once, return, cooldown`,()=>{
+  const {sql,game,player,clock}=world();
+  try{
+   const id=player({'ENG-01':party*3}),target=worldSite(species+'-'+level);
+   const action={kind:'worldMarch',worldKind:species,encounterId:target.id,units:{'ENG-01':party}};
+   const started=game.command(id,'world-'+species,action);
+   const order=()=>game.getPlayer(id).worldOrders62[0];
+   assert.equal(order().worldKind,species);
+   assert.ok(started.world.encounters.some(e=>e.id===target.id&&e.status==='reserved'),'target reserved while the army marches');
+   // a second player may not attack the reserved creature
+   const other=player({'ENG-01':50});
+   assert.throws(()=>game.command(other,'world-'+species+'-other',{...action,units:{'ENG-01':50}}),/занята|восстанавливается/);
+   clock.now=order().arrivesAt;game.state(id);
+   const battle=structuredClone(order().battle);assert.equal(battle.outcome,'victory');
+   assert.ok(battle.events.some(e=>e.kind===ability),'the species special attack is part of the server battle');
+   const food0=game.state(id).v6.stock.food;
+   clock.now=order().battleEndsAt;const ended=game.state(id);
+   assert.equal(ended.reports.length,1);assert.equal(ended.reports[0].creature.species,species);
+   assert.equal(ended.reports[0].rewards.items[creatureSpec(species,level).item],creatureSpec(species,level).rewards.material);
+   const stock=structuredClone(ended.v6.stock);
+   // repeated polls and the same command again do not grant the reward twice
+   assert.deepEqual(game.state(id).v6.stock,stock);
+   assert.equal(game.command(id,'world-'+species,action).reports.length,1);
+   assert.deepEqual(game.state(id).v6.stock,stock);
+   assert.ok(game.state(id).world.encounters.some(e=>e.id===target.id&&e.status==='defeated'&&e.hp===0),'defeated until respawn');
+   assert.throws(()=>game.command(id,'world-'+species+'-again',action),/занята|восстанавливается/);
+   clock.now=order().returnsAt;const back=game.state(id);
+   assert.equal(back.v6.healthy['ENG-01'],party*2+battle.surviving['ENG-01']);
+   assert.ok(stock.food>=food0);
+   clock.now=order().cooldownUntil+1;
+   assert.ok(game.state(id).world.encounters.some(e=>e.id===target.id&&e.status==='alive'),'respawned after the catalog cooldown');
+  }finally{sql.close();}
+ });
+
+test('legacy worldKind "velkor" addressed to a Kamneklyk site is accepted and recorded as kamneklyk',()=>{
+ const {sql,game,player}=world();
+ try{
+  const id=player({'ENG-01':80});
+  game.command(id,'legacy-kind',{kind:'worldMarch',worldKind:'velkor',encounterId:'kamneklyk-2',units:{'ENG-01':60}});
+  assert.equal(game.getPlayer(id).worldOrders62[0].worldKind,'kamneklyk');
+  assert.throws(()=>game.command(id,'wrong-kind',{kind:'worldMarch',worldKind:'dragor',encounterId:'kamneklyk-3',units:{'ENG-01':1}}),/Неизвестная цель|TARGET/);
+ }finally{sql.close();}
+});
+
+test('defeat against Dragor III: no hunt reward, survivors come home, the creature stays alive',()=>{
+ const {sql,game,player,clock}=world();
+ try{
+  const id=player({'ENG-09':12});
+  game.command(id,'dragor-defeat',{kind:'worldMarch',worldKind:'dragor',encounterId:'dragor-3',units:{'ENG-09':12}});
+  const order=()=>game.getPlayer(id).worldOrders62[0];
+  clock.now=order().arrivesAt;game.state(id);const battle=structuredClone(order().battle);assert.equal(battle.outcome,'defeat');
+  clock.now=order().battleEndsAt;const ended=game.state(id);
+  assert.equal(ended.reports[0].outcome,'defeat');
+  assert.deepEqual(ended.reports[0].rewards.items,{});
+  assert.ok(game.state(id).world.encounters.some(e=>e.id==='dragor-3'&&e.status==='alive'));
+  clock.now=order().returnsAt;const back=game.state(id);
+  assert.equal(back.v6.healthy['ENG-09']??0,battle.surviving['ENG-09']??0);
+ }finally{sql.close();}
+});
